# A positive control catches broken includes/flags before checking diagnostics.
set(options -std=c++14 -fsyntax-only -I${FF_SOURCE_DIR} ${FF_DEP_FLAGS})
if(FF_NO_EXCEPTIONS)
    list(APPEND options -fno-exceptions -DFLUX_FOUNDRY_NO_EXCEPTION_STRICT=1)
endif()
if(FF_COMPONENT STREQUAL "io_uring")
    set(last_case 13)
else()
    set(last_case 19)
endif()
foreach(case RANGE 0 ${last_case})
    execute_process(
        COMMAND "${FF_CXX_COMPILER}" ${options} -DFF_IO_CASE=${case}
            "${FF_SOURCE_DIR}/test/${FF_COMPONENT}_contract_reject.cpp"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(case EQUAL 0)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${FF_COMPONENT} positive control failed\n${output}\n${errors}")
        endif()
        continue()
    endif()
    if(FF_COMPONENT STREQUAL "io_uring")
        if(case EQUAL 5)
            set(expected "io_uring operation requirement: Operation must be nothrow move constructible")
        elseif(case EQUAL 6)
            set(expected "io_uring operation requirement: Operation must be nothrow destructible")
        elseif(case EQUAL 7 OR case EQUAL 12)
            set(expected "io_uring operation requirement: Operation must be an unqualified object type")
        elseif(case GREATER_EQUAL 8 AND case LESS_EQUAL 10)
            set(expected "I/O awaitable requirement: specialize extension::detail::io_error<E>")
        else()
            set(expected "io_uring operation requirement: provide void prepare")
        endif()
    else()
        if(case LESS_EQUAL 4)
            set(expected "DPDK API requirement: packet_type must name an unqualified object type")
        elseif(case LESS_EQUAL 7)
            set(expected "DPDK API requirement: provide static void free")
        elseif(case LESS_EQUAL 11)
            set(expected "DPDK API requirement: provide static uint16_t rx")
        elseif(case LESS_EQUAL 14)
            set(expected "DPDK API requirement: provide static uint16_t tx")
        elseif(case LESS_EQUAL 16)
            set(expected "DPDK batch requirement: Capacity must be in 1..65535")
        else()
            set(expected "I/O awaitable requirement: specialize extension::detail::io_error<E>")
        endif()
    endif()
    string(FIND "${errors}" "${expected}" found)
    if(result EQUAL 0 OR found EQUAL -1)
        message(FATAL_ERROR "${FF_COMPONENT} case ${case}: expected contract diagnostic missing\n${output}\n${errors}")
    endif()
endforeach()
message(STATUS "${FF_COMPONENT}: positive control and ${last_case} intended rejections passed")
